+/// Non-POSIX, the BSDs' and glibc's: random bytes from the platform's
+/// source ([`Pal::getrandom`]), which do not run out.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn arc4random_buf(buf: *mut c_void, nbytes: size_t) {
+    let buf = unsafe { slice::from_raw_parts_mut(buf.cast::<u8>(), nbytes) };
+    let mut done = 0;
+    while done < nbytes {
+        match Sys::getrandom(&mut buf[done..], 0) {
+            Ok(n) => done += n,
+            Err(Errno(EINTR)) => {}
+            // as glibc: there is no failure to report
+            Err(_) => intrinsics::abort(),
+        }
+    }
+}
+
+/// Non-POSIX, see [`arc4random_buf`].
+#[unsafe(no_mangle)]
+pub extern "C" fn arc4random() -> u32 {
+    let mut value = 0u32;
+    unsafe { arc4random_buf((&raw mut value).cast(), mem::size_of::<u32>()) };
+    value
