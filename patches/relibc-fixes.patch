diff --git a/src/header/search/mod.rs b/src/header/search/mod.rs
new file mode 100644
index 00000000..a93e8b7f
--- /dev/null
+++ b/src/header/search/mod.rs
@@ -0,0 +1,232 @@
+//! `search.h` implementation: the binary search trees (tsearch and
+//! friends), as an AVL tree.
+//!
+//! See <https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/search.h.html>.
+
+use core::ptr;
+
+use alloc::boxed::Box;
+
+use crate::platform::types::{c_int, c_void};
+
+/// See <https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/search.h.html>.
+#[repr(C)]
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum VISIT {
+    preorder,
+    postorder,
+    endorder,
+    leaf,
+}
+
+/// The comparison function of the trees (not a type of search.h).
+/// cbindgen:ignore
+type Compar = Option<unsafe extern "C" fn(*const c_void, *const c_void) -> c_int>;
+
+/// A node. As POSIX requires, it begins with the pointer to its key, as the
+/// functions return pointers to nodes, which callers dereference as `void **`.
+/// cbindgen:ignore
+#[repr(C)]
+struct Node {
+    key: *const c_void,
+    child: [*mut Node; 2],
+    height: c_int,
+}
+
+fn height(n: *mut Node) -> c_int {
+    if n.is_null() { 0 } else { unsafe { (*n).height } }
+}
+
+unsafe fn update(n: *mut Node) {
+    unsafe { (*n).height = 1 + height((*n).child[0]).max(height((*n).child[1])) };
+}
+
+/// Rotate so that the `dir` child becomes the root.
+unsafe fn rotate(n: *mut Node, dir: usize) -> *mut Node {
+    unsafe {
+        let c = (*n).child[dir];
+        (*n).child[dir] = (*c).child[1 - dir];
+        (*c).child[1 - dir] = n;
+        update(n);
+        update(c);
+        c
+    }
+}
+
+unsafe fn balance(n: *mut Node) -> *mut Node {
+    unsafe {
+        update(n);
+        let diff = height((*n).child[1]) - height((*n).child[0]);
+        if diff.abs() <= 1 {
+            return n;
+        }
+        let dir = (diff > 0) as usize; /* the heavy side */
+        let c = (*n).child[dir];
+        if height((*c).child[1 - dir]) > height((*c).child[dir]) {
+            (*n).child[dir] = rotate(c, 1 - dir);
+        }
+        rotate(n, dir)
+    }
+}
+
+unsafe fn compare(compar: Compar, a: *const c_void, b: *const c_void) -> c_int {
+    unsafe { compar.expect("search.h: no comparison function")(a, b) }
+}
+
+/// Insert `key` below `n` unless present; `found`: the node of the key.
+unsafe fn insert(n: *mut Node, key: *const c_void, compar: Compar, found: &mut *mut Node) -> *mut Node {
+    unsafe {
+        if n.is_null() {
+            let node = Box::into_raw(Box::new(Node { key, child: [ptr::null_mut(); 2], height: 1 }));
+            *found = node;
+            return node;
+        }
+        let c = compare(compar, key, (*n).key);
+        if c == 0 {
+            *found = n;
+            return n;
+        }
+        let dir = (c > 0) as usize;
+        (*n).child[dir] = insert((*n).child[dir], key, compar, found);
+        balance(n)
+    }
+}
+
+/// See <https://pubs.opengroup.org/onlinepubs/9799919799/functions/tsearch.html>.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tsearch(key: *const c_void, rootp: *mut *mut c_void, compar: Option<unsafe extern "C" fn(*const c_void, *const c_void) -> c_int>) -> *mut c_void {
+    if rootp.is_null() {
+        return ptr::null_mut();
+    }
+    let mut found = ptr::null_mut();
+    unsafe { *rootp = insert((*rootp).cast(), key, compar, &mut found).cast() };
+    found.cast()
+}
+
+/// See <https://pubs.opengroup.org/onlinepubs/9799919799/functions/tfind.html>.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tfind(key: *const c_void, rootp: *const *mut c_void, compar: Option<unsafe extern "C" fn(*const c_void, *const c_void) -> c_int>) -> *mut c_void {
+    if rootp.is_null() {
+        return ptr::null_mut();
+    }
+    let mut n: *mut Node = unsafe { (*rootp).cast() };
+    while !n.is_null() {
+        let c = unsafe { compare(compar, key, (*n).key) };
+        if c == 0 {
+            return n.cast();
+        }
+        n = unsafe { (*n).child[(c > 0) as usize] };
+    }
+    ptr::null_mut()
+}
+
+/// Remove the leftmost node below `n` into `min`.
+unsafe fn remove_min(n: *mut Node, min: &mut *mut Node) -> *mut Node {
+    unsafe {
+        if (*n).child[0].is_null() {
+            *min = n;
+            return (*n).child[1];
+        }
+        (*n).child[0] = remove_min((*n).child[0], min);
+        balance(n)
+    }
+}
+
+/// Delete `key` below `n`; `parent` of the deleted node into `result`.
+unsafe fn delete(
+    n: *mut Node,
+    key: *const c_void,
+    compar: Compar,
+    parent: *mut Node,
+    result: &mut *mut Node,
+    deleted: &mut bool,
+) -> *mut Node {
+    unsafe {
+        if n.is_null() {
+            return n;
+        }
+        let c = compare(compar, key, (*n).key);
+        if c != 0 {
+            let dir = (c > 0) as usize;
+            (*n).child[dir] = delete((*n).child[dir], key, compar, n, result, deleted);
+            return balance(n);
+        }
+        *deleted = true;
+        *result = parent;
+        let (l, r) = ((*n).child[0], (*n).child[1]);
+        drop(Box::from_raw(n));
+        if r.is_null() {
+            return l;
+        }
+        let mut min = ptr::null_mut();
+        let r = remove_min(r, &mut min);
+        (*min).child = [l, r];
+        balance(min)
+    }
+}
+
+/// See <https://pubs.opengroup.org/onlinepubs/9799919799/functions/tdelete.html>.
+///
+/// Returns the parent of the deleted node; deleting the root, for which
+/// POSIX leaves the value unspecified, the (non-null) `rootp`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tdelete(key: *const c_void, rootp: *mut *mut c_void, compar: Option<unsafe extern "C" fn(*const c_void, *const c_void) -> c_int>) -> *mut c_void {
+    if rootp.is_null() || unsafe { (*rootp).is_null() } {
+        return ptr::null_mut();
+    }
+    let (mut result, mut deleted) = (ptr::null_mut(), false);
+    unsafe {
+        *rootp = delete((*rootp).cast(), key, compar, ptr::null_mut(), &mut result, &mut deleted).cast();
+    }
+    if !deleted {
+        ptr::null_mut()
+    } else if result.is_null() {
+        rootp.cast()
+    } else {
+        result.cast()
+    }
+}
+
+
+unsafe fn walk(n: *const Node, action: unsafe extern "C" fn(*const c_void, VISIT, c_int), depth: c_int) {
+    if n.is_null() {
+        return;
+    }
+    unsafe {
+        let [l, r] = (*n).child;
+        if l.is_null() && r.is_null() {
+            action(n.cast(), VISIT::leaf, depth);
+            return;
+        }
+        action(n.cast(), VISIT::preorder, depth);
+        walk(l, action, depth + 1);
+        action(n.cast(), VISIT::postorder, depth);
+        walk(r, action, depth + 1);
+        action(n.cast(), VISIT::endorder, depth);
+    }
+}
+
+/// See <https://pubs.opengroup.org/onlinepubs/9799919799/functions/twalk.html>.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn twalk(root: *const c_void, action: Option<unsafe extern "C" fn(*const c_void, VISIT, c_int)>) {
+    if let Some(action) = action {
+        unsafe { walk(root.cast(), action, 0) };
+    }
+}
+
+/// Non-POSIX, glibc's: free the tree, its keys through `free_node`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tdestroy(root: *mut c_void, free_node: Option<unsafe extern "C" fn(*mut c_void)>) {
+    let n: *mut Node = root.cast();
+    if n.is_null() {
+        return;
+    }
+    unsafe {
+        tdestroy((*n).child[0].cast(), free_node);
+        tdestroy((*n).child[1].cast(), free_node);
+        if let Some(free_node) = free_node {
+            free_node((*n).key.cast_mut());
+        }
+        drop(Box::from_raw(n));
+    }
+}
