+/// A finite floating-point value as %a prints it: leading digit (1, or 0
+/// for zero and subnormals), the fraction bits, and the binary exponent
+struct HexFloat {
+    negative:  bool,
+    lead:      u8,
+    frac:      u128,
+    frac_bits: u32,
+    exp:       i32,
+}
+
+impl HexFloat {
+    fn from_f64(f: c_double) -> Option<HexFloat> {
+        if !f.is_finite() {
+            return None;
+        }
+        let bits = f.to_bits();
+        let negative = bits >> 63 != 0;
+        let e = ((bits >> 52) & 0x7ff) as i32;
+        let m = (bits & ((1 << 52) - 1)) as u128;
+        Some(match (e, m) {
+            (0, 0) => HexFloat { negative, lead: 0, frac: 0, frac_bits: 52, exp: 0 },
+            (0, _) => HexFloat { negative, lead: 0, frac: m, frac_bits: 52, exp: -1022 },
+            _      => HexFloat { negative, lead: 1, frac: m, frac_bits: 52, exp: e - 1023 },
+        })
+    }
+
+    /// An x86 80-bit long double (relibc passes its bit pattern), exactly
+    #[cfg(target_arch = "x86_64")]
+    fn from_longdouble(raw: c_longdouble) -> Option<HexFloat> {
+        let m = raw as u64;
+        let se = (raw >> 64) as u16;
+        let negative = se >> 15 != 0;
+        let e = (se & 0x7fff) as i32;
+        let frac = (m & ((1 << 63) - 1)) as u128;
+        let lead = (m >> 63) as u8;
+        Some(match e {
+            0x7fff => return None,
+            0 if m == 0 => HexFloat { negative, lead: 0, frac: 0, frac_bits: 63, exp: 0 },
+            0 => HexFloat { negative, lead, frac, frac_bits: 63, exp: -16382 },
+            _ => HexFloat { negative, lead, frac, frac_bits: 63, exp: e - 16383 },
+        })
+    }
+
+    #[cfg(not(target_arch = "x86_64"))]
+    fn from_longdouble(raw: c_longdouble) -> Option<HexFloat> {
+        HexFloat::from_f64(unsafe { relibc_ldtod(&raw const raw) })
+    }
+
+    /// Everything after "0x": digits, point, 'p' and exponent
+    fn string(&self, precision: Option<usize>, upper: bool, alternate: bool) -> String {
+        let digits = self.frac_bits.div_ceil(4) as usize;
+        let mut frac = self.frac << (digits as u32 * 4 - self.frac_bits);
+        let mut lead = self.lead;
+        let mut exp = self.exp;
+        let mut ndigits = digits;
+
+        if let Some(p) = precision {
+            if p < digits {
+                // round half to even at the last kept digit
+                let drop = ((digits - p) * 4) as u32;
+                let rest = frac & ((1u128 << drop) - 1);
+                let half = 1u128 << (drop - 1);
+                frac >>= drop;
+                let odd = if p == 0 { lead & 1 == 1 } else { frac & 1 == 1 };
+                if rest > half || (rest == half && odd) {
+                    frac += 1;
+                    if p == 0 || frac >> (p * 4) != 0 {
+                        frac = 0;
+                        lead += 1;
+                        if lead == 2 {
+                            lead = 1;
+                            exp += 1;
+                        }
+                    }
+                }
+            } else {
+                frac <<= ((p - digits) * 4) as u32;
+            }
+            ndigits = p;
+        } else {
+            // the shortest exact form: no trailing zeros
+            while ndigits > 0 && frac & 0xf == 0 {
+                frac >>= 4;
+                ndigits -= 1;
+            }
+        }
+
+        let mut out = String::new();
+        out.push((b'0' + lead) as char);
+        if ndigits > 0 || alternate {
+            out.push('.');
+        }
+        for i in (0..ndigits).rev() {
+            let d = ((frac >> (i * 4)) & 0xf) as u8;
+            let c = if d < 10 { b'0' + d } else if upper { b'A' + d - 10 } else { b'a' + d - 10 };
+            out.push(c as char);
+        }
+        out.push(if upper { 'P' } else { 'p' });
+        out.push_str(&format!("{:+}", exp));
+        out
+    }
+}
+
