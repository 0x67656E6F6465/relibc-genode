+
+/// Non-POSIX, see [`arc4random_buf`]: uniform in `[0, upper_bound)`.
+#[unsafe(no_mangle)]
+pub extern "C" fn arc4random_uniform(upper_bound: u32) -> u32 {
+    if upper_bound < 2 {
+        return 0;
+    }
+    // reject the values below 2^32 % upper_bound, which would bias the result
+    let min = upper_bound.wrapping_neg() % upper_bound;
+    loop {
+        let r = arc4random();
+        if r >= min {
+            return r % upper_bound;
+        }
+    }
+}
