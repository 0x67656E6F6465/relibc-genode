+/// Non-POSIX, Linux's and the BSDs': [`accept`] with `SOCK_NONBLOCK` and
+/// `SOCK_CLOEXEC`, set on the new socket through `fcntl`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn accept4(
+    socket: c_int,
+    address: *mut sockaddr,
+    address_len: *mut socklen_t,
+    flags: c_int,
+) -> c_int {
+    use crate::header::fcntl::{F_GETFL, F_SETFD, F_SETFL, FD_CLOEXEC, O_NONBLOCK};
+    use constants::{SOCK_CLOEXEC, SOCK_NONBLOCK};
+
+    if flags & !(SOCK_NONBLOCK | SOCK_CLOEXEC) != 0 {
+        platform::ERRNO.set(crate::header::errno::EINVAL);
+        return -1;
+    }
+    let fd = unsafe { accept(socket, address, address_len) };
+    if fd < 0 {
+        return fd;
+    }
+    let set = || -> crate::error::Result<()> {
+        if flags & SOCK_CLOEXEC != 0 {
+            Sys::fcntl(fd, F_SETFD, FD_CLOEXEC as _)?;
+        }
+        if flags & SOCK_NONBLOCK != 0 {
+            let fl = Sys::fcntl(fd, F_GETFL, 0)?;
+            Sys::fcntl(fd, F_SETFL, (fl | O_NONBLOCK) as _)?;
+        }
+        Ok(())
+    };
+    match set() {
+        Ok(()) => fd,
+        Err(err) => {
+            let _ = Sys::close(fd);
+            Err::<c_int, _>(err).or_minus_one_errno()
+        }
+    }
+}
